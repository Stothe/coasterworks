{
  "name": "coasterworks-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:web": "pnpm --filter @coasterworks/web dev",
    "dev:desktop": "pnpm --filter @coasterworks/desktop dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @coasterworks/web e2e",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "^5.6",
    "vitest": "^3"
  }
}
